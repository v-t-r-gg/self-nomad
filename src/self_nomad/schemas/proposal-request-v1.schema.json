{
  "$defs": {
    "IntakeOperation": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content"
        },
        "expected_after_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected After Sha256"
        },
        "expected_before_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Before Sha256"
        },
        "kind": {
          "enum": [
            "add",
            "replace",
            "delete"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "IntakeOperation",
      "type": "object"
    },
    "IntakeSource": {
      "additionalProperties": false,
      "properties": {
        "agent_identifier": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Identifier"
        },
        "correlation_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "runtime": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "runtime"
      ],
      "title": "IntakeSource",
      "type": "object"
    }
  },
  "$id": "https://github.com/v-t-r-gg/self-nomad/schemas/proposal-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Framework-neutral agent intake request for proposing changes to a portable self repository. Inline content is UTF-8 text only; filesystem content_source paths are not accepted.",
  "properties": {
    "operations": {
      "items": {
        "$ref": "#/$defs/IntakeOperation"
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "reason": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/IntakeSource"
    },
    "target_branch": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Branch"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "reason",
    "source",
    "operations"
  ],
  "title": "self-nomad ProposalRequest v1",
  "type": "object"
}
